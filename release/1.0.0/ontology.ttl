#    Individuals
#################################################################

###  https://creativecommons.org/licenses/by/4.0/
<https://creativecommons.org/licenses/by/4.0/> rdf:type owl:NamedIndividual ,
                                                        <http://purl.org/dc/terms/LicenseDocument> ;
                                               rdfs:comment "A permissive open license allowing reuse and distribution with attribution."@en ;
                                               rdfs:label "Creative Commons Attribution 4.0 International"@en .


###  https://w3id.org/fgv#ExpectedValueFocus
:ExpectedValueFocus rdf:type owl:NamedIndividual ,
                             :FocusArea ;
                    rdfs:comment "Guidance describing the expected value, result, or outcome."@en ;
                    rdfs:label "Expected Value"@en .


###  https://w3id.org/fgv#HowFocus
:HowFocus rdf:type owl:NamedIndividual ,
                   :FocusArea ;
          rdfs:comment "Guidance describing how something can be implemented, performed, or evaluated."@en ;
          rdfs:label "How"@en .


###  https://w3id.org/fgv#MoreFocus
:MoreFocus rdf:type owl:NamedIndividual ,
                    :FocusArea ;
           rdfs:comment "Guidance providing additional information or resources."@en ;
           rdfs:label "More"@en .


###  https://w3id.org/fgv#WhatFocus
:WhatFocus rdf:type owl:NamedIndividual ,
                    :FocusArea ;
           rdfs:comment "Guidance describing what is being addressed or evaluated."@en ;
           rdfs:label "What"@en .


###  https://w3id.org/fgv#WhyFocus
:WhyFocus rdf:type owl:NamedIndividual ,
                   :FocusArea ;
          rdfs:comment "Guidance explaining why the subject is relevant or important."@en ;
          rdfs:label "Why"@en .


