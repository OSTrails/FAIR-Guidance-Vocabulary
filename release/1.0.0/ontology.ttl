###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://semanticscience.org/resource/SIO_000341
<http://semanticscience.org/resource/SIO_000341> rdf:type owl:ObjectProperty ;
                                                 rdfs:comment "Relates a guidance element or an abstract external resource to its manifestation as a concrete external resource (e.g., PID, WebPage, or Annotation)."@en ;
                                                 rdfs:label "is manifested as"@en .


###  http://www.w3.org/ns/dqv#inDimension
<http://www.w3.org/ns/dqv#inDimension> rdf:type owl:ObjectProperty ;
                                       rdfs:domain :GuidanceElement ;
                                       rdfs:range <http://www.w3.org/ns/dqv#Dimension> ;
                                       rdfs:comment "Relates a guidance element to the quality dimension it addresses."@en ;
                                       rdfs:label "in dimension"@en .


###  http://www.w3.org/ns/prov#atLocation
<http://www.w3.org/ns/prov#atLocation> rdf:type owl:ObjectProperty ;
                                       rdfs:comment "Relates a guidance element to a location associated with its provenance."@en ;
                                       rdfs:label "location"@en .


###  http://www.w3.org/ns/prov#wasAttributedTo
<http://www.w3.org/ns/prov#wasAttributedTo> rdf:type owl:ObjectProperty ;
                                            rdfs:comment "Relates a guidance element to an agent associated with its provenance."@en ;
                                            rdfs:label "agent"@en .


###  http://www.w3.org/ns/prov#wasRevisionOf
<http://www.w3.org/ns/prov#wasRevisionOf> rdf:type owl:ObjectProperty ;
                                          rdfs:comment "Relates a resource to an earlier resource of the same type that it is a revised version of."@en ;
                                          rdfs:label "was revision of"@en .


###  https://w3id.org/fgv#domain
:domain rdf:type owl:ObjectProperty ;
        rdfs:domain :GuidanceElement ;
        rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
        rdfs:comment "Field of science and technology classification (FOS) for this guidance element."@en ;
        rdfs:label "domain"@en .


###  https://w3id.org/fgv#hasFocusArea
:hasFocusArea rdf:type owl:ObjectProperty ;
              rdfs:domain :GuidanceElement ;
              rdfs:range :FocusArea ;
              rdfs:comment "Relates a guidance element to a focus area addressed by the guidance."@en ;
              rdfs:label "has focus area"@en .


###  https://w3id.org/fgv#hasMaturityValue
:hasMaturityValue rdf:type owl:ObjectProperty ;
                  rdfs:domain :GuidanceElement ;
                  rdfs:range :MaturityValue ;
                  rdfs:comment "Relates a guidance element to its maturity value."@en ;
                  rdfs:label "has maturity value"@en .


###  https://w3id.org/fgv#hasOrderedInstructions
:hasOrderedInstructions rdf:type owl:ObjectProperty ;
                        rdfs:domain :Procedure ;
                        rdfs:range rdf:List ;
                        rdfs:comment "A procedure may list its instructions in a defined order."@en ;
                        rdfs:label "has ordered instructions"@en .


###  https://w3id.org/fgv#resolvesTo
:resolvesTo rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :PersistentIdentifier ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :Annotation
                                       :ObjectOrServiceAPI
                                       :WebPage
                                     )
                       ] ;
            rdfs:comment "Indicates the resource a persistent identifier or annotation resolves to (e.g., a web page, annotation, or API)."@en ;
            rdfs:label "resolves to"@en ;
            rdfs:seeAlso <http://www.w3.org/ns/dcat#accessURL> .


