     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/fgv#">
        <owl:versionIRI rdf:resource="https://w3id.org/fgv/1.0.0"/>
        <terms:abstract xml:lang="en">A vocabulary to describe Guidance.</terms:abstract>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-13</terms:created>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0255-5101"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-7874-0362"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0003-1106-8441"/>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-23</terms:modified>
        <terms:title xml:lang="en">FAIR Guidance Vocabulary (FGV) — Core Ontology</terms:title>
        <rdfs:comment xml:lang="en">An ontology capturing core concepts and relations from the FAIR Guidance diagram.</rdfs:comment>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


