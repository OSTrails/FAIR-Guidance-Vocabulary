    <!-- http://semanticscience.org/resource/SIO_000341 -->


    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000341">
        <rdfs:comment xml:lang="en">Relates a guidance element or an abstract external resource to its manifestation as a concrete external resource (e.g., PID, WebPage, or Annotation).</rdfs:comment>
        <rdfs:label xml:lang="en">is manifested as</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dqv#inDimension -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dqv#inDimension">
        <rdfs:domain rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dqv#Dimension"/>
        <rdfs:comment xml:lang="en">Relates a guidance element to the quality dimension it addresses.</rdfs:comment>
        <rdfs:label xml:lang="en">in dimension</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#atLocation -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#atLocation">
        <rdfs:comment xml:lang="en">Relates a guidance element to a location associated with its provenance.</rdfs:comment>
        <rdfs:label xml:lang="en">location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAttributedTo -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
        <rdfs:comment xml:lang="en">Relates a guidance element to an agent associated with its provenance.</rdfs:comment>
        <rdfs:label xml:lang="en">agent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasRevisionOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasRevisionOf">
        <rdfs:comment xml:lang="en">Relates a resource to an earlier resource of the same type that it is a revised version of.</rdfs:comment>
        <rdfs:label xml:lang="en">was revision of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fgv#domain -->


    <owl:ObjectProperty rdf:about="https://w3id.org/fgv#domain">
        <rdfs:domain rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Field of science and technology classification (FOS) for this guidance element.</rdfs:comment>
        <rdfs:label xml:lang="en">domain</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fgv#hasFocusArea -->


    <owl:ObjectProperty rdf:about="https://w3id.org/fgv#hasFocusArea">
        <rdfs:domain rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
        <rdfs:range rdf:resource="https://w3id.org/fgv#FocusArea"/>
        <rdfs:comment xml:lang="en">Relates a guidance element to a focus area addressed by the guidance.</rdfs:comment>
        <rdfs:label xml:lang="en">has focus area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fgv#hasMaturityValue -->


    <owl:ObjectProperty rdf:about="https://w3id.org/fgv#hasMaturityValue">
        <rdfs:domain rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
        <rdfs:range rdf:resource="https://w3id.org/fgv#MaturityValue"/>
        <rdfs:comment xml:lang="en">Relates a guidance element to its maturity value.</rdfs:comment>
        <rdfs:label xml:lang="en">has maturity value</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fgv#hasOrderedInstructions -->


    <owl:ObjectProperty rdf:about="https://w3id.org/fgv#hasOrderedInstructions">
        <rdfs:domain rdf:resource="https://w3id.org/fgv#Procedure"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
        <rdfs:comment xml:lang="en">A procedure may list its instructions in a defined order.</rdfs:comment>
        <rdfs:label xml:lang="en">has ordered instructions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/fgv#resolvesTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/fgv#resolvesTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/fgv#PersistentIdentifier"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/fgv#Annotation"/>
                    <rdf:Description rdf:about="https://w3id.org/fgv#ObjectOrServiceAPI"/>
                    <rdf:Description rdf:about="https://w3id.org/fgv#WebPage"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Indicates the resource a persistent identifier or annotation resolves to (e.g., a web page, annotation, or API).</rdfs:comment>
        <rdfs:label xml:lang="en">resolves to</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.w3.org/ns/dcat#accessURL"/>
    </owl:ObjectProperty>
    


