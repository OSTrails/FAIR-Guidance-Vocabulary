    <!-- https://w3id.org/fgv#Annotation -->


    <owl:Class rdf:about="https://w3id.org/fgv#Annotation">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001166"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/fgv#ExternalResource"/>
        <rdfs:comment xml:lang="en">A structured note or comment associated with another resource.</rdfs:comment>
        <rdfs:label xml:lang="en">Annotation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#Benchmark -->


    <owl:Class rdf:about="https://w3id.org/fgv#Benchmark">
        <rdfs:subClassOf rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">Quantifiable standards or reference points used to compare or evaluate performance, practices, or processes.</rdfs:comment>
        <rdfs:label xml:lang="en">Benchmark</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.org/DefinedTerm"/>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#BestPractice -->


    <owl:Class rdf:about="https://w3id.org/fgv#BestPractice">
        <rdfs:subClassOf rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">Proven methods or approaches that are widely accepted as the most effective in achieving desired outcomes.</rdfs:comment>
        <rdfs:label xml:lang="en">Best Practice</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.org/BestPractice"/>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#ExternalResource -->


    <owl:Class rdf:about="https://w3id.org/fgv#ExternalResource">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#atLocation"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/prov#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/prov#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasRevisionOf"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/fgv#ExternalResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">
A resource that represents or provides access to a piece of guidance,
such as a Persistent Identifier, Web Page, Annotation, or Object/Service API.
</rdfs:comment>
        <rdfs:label xml:lang="en">Reference / External Resource</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#FAQ -->


    <owl:Class rdf:about="https://w3id.org/fgv#FAQ">
        <rdfs:subClassOf rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">A curated list of common queries and clear, concise answers about a product, service, policy, or process.</rdfs:comment>
        <rdfs:label xml:lang="en">Frequently Asked Questions</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.org/FAQPage"/>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#FocusArea -->


    <owl:Class rdf:about="https://w3id.org/fgv#FocusArea">
        <rdfs:comment xml:lang="en">The aspect of a Guidance Element addressed by the guidance, such as what it concerns, why it is relevant, how it can be applied, additional information, or an expected value.</rdfs:comment>
        <rdfs:label xml:lang="en">Focus Area</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#Framework -->


    <owl:Class rdf:about="https://w3id.org/fgv#Framework">
        <rdfs:subClassOf rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">A conceptual or structural foundation that organizes, aligns, and relates key components (such as goals, principles, processes, roles, and tools) within a particular domain or system of practice.</rdfs:comment>
        <rdfs:label xml:lang="en">Framework</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/Standard"/>
        <rdfs:seeAlso rdf:resource="https://schema.org/Intangible"/>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#GuidanceElement -->


    <owl:Class rdf:about="https://w3id.org/fgv#GuidanceElement">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/CreativeWork"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000341"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/fgv#ExternalResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#atLocation"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/prov#Location"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/prov#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/prov#wasRevisionOf"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A discrete item of guidance (standard, procedure, FAQ, etc.) that can be categorized by one or more Guidance Dimensions such as Domain, Motivation, Actor, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Guidance Element</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.org/CreativeWork"/>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#Guideline -->


    <owl:Class rdf:about="https://w3id.org/fgv#Guideline">
        <rdfs:subClassOf rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">A set of recommendations describing an approach to achieve a desired outcome, expressed as an ordered list of Instructions.</rdfs:comment>
        <rdfs:label xml:lang="en">Guideline</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#Instruction -->


    <owl:Class rdf:about="https://w3id.org/fgv#Instruction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">A single, discrete step contained within a Standard or Guideline.</rdfs:comment>
        <rdfs:label xml:lang="en">Instruction</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#MaturityValue -->


    <owl:Class rdf:about="https://w3id.org/fgv#MaturityValue">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dqv#QualityMeasurement"/>
        <rdfs:comment xml:lang="en">A quality measurement expressing the maturity level of a guidance element.</rdfs:comment>
        <rdfs:label xml:lang="en">Maturity Value</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#ObjectOrServiceAPI -->


    <owl:Class rdf:about="https://w3id.org/fgv#ObjectOrServiceAPI">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001190"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/fgv#ExternalResource"/>
        <rdfs:comment xml:lang="en">A data service or API providing machine-actionable access to guidance or data.</rdfs:comment>
        <rdfs:label xml:lang="en">Object or Service / API</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#PersistentIdentifier -->


    <owl:Class rdf:about="https://w3id.org/fgv#PersistentIdentifier">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000675"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/fgv#ExternalResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/fgv#resolvesTo"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/fgv#Annotation"/>
                            <rdf:Description rdf:about="https://w3id.org/fgv#ObjectOrServiceAPI"/>
                            <rdf:Description rdf:about="https://w3id.org/fgv#WebPage"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An identifier that uniquely and persistently identifies a resource.</rdfs:comment>
        <rdfs:label xml:lang="en">Persistent Identifier</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#Procedure -->


    <owl:Class rdf:about="https://w3id.org/fgv#Procedure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">A defined and ordered series of steps or tasks to be performed to achieve a specific outcome or fulfill a process.</rdfs:comment>
        <rdfs:label xml:lang="en">Procedure</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.org/HowTo"/>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#Standard -->


    <owl:Class rdf:about="https://w3id.org/fgv#Standard">
        <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/Standard"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">Documented agreements containing technical specifications or criteria to ensure consistent quality, safety, or interoperability.</rdfs:comment>
        <rdfs:label xml:lang="en">Standard</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.org/TechArticle"/>
    </owl:Class>
    


    <!-- https://w3id.org/fgv#WebPage -->


    <owl:Class rdf:about="https://w3id.org/fgv#WebPage">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000302"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/fgv#ExternalResource"/>
        <rdfs:comment xml:lang="en">A document or page accessible on the Web.</rdfs:comment>
        <rdfs:label xml:lang="en">Web Page</rdfs:label>
    </owl:Class>
    


