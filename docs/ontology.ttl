@prefix : <https://w3id.org/fgv#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/fgv#> .

<https://w3id.org/fgv#> rdf:type owl:Ontology ;
                         owl:versionIRI <https://w3id.org/fgv/0.1.1> ;
                         <http://purl.org/dc/terms/abstract> "A vocabulary to describe Guidance."@en ;
                         <http://purl.org/dc/terms/created> "2025-10-13"^^xsd:date ;
                         <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-0255-5101> ,
                                                            <https://orcid.org/0000-0002-7874-0362> ,
                                                            <https://orcid.org/0000-0003-1106-8441> ;
                         <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                         <http://purl.org/dc/terms/modified> "2025-10-13"^^xsd:date ;
                         rdfs:comment "An ontology capturing core concepts and relations from the FAIR Guidance diagram."@en ;
                         owl:versionInfo "0.1.1" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/abstract
<http://purl.org/dc/terms/abstract> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://semanticscience.org/resource/SIO_000341
<http://semanticscience.org/resource/SIO_000341> rdf:type owl:ObjectProperty ,
                                                          owl:FunctionalProperty ;
                                                 rdfs:domain :ExternalResource ;
                                                 rdfs:range :ExternalResource ;
                                                 rdfs:comment "Relates an abstract reference to its single manifestation (e.g., PID, WebPage, or Annotation)."@en ;
                                                 rdfs:label "is manifested as"@en .


###  https://w3id.org/fgv#describes
:describes rdf:type owl:ObjectProperty ;
           rdfs:domain :WebPage ;
           rdfs:range :ObjectOrServiceAPI ;
           rdfs:comment "Relates a web page to the API or object it describes."@en ;
           rdfs:label "describes"@en .


###  https://w3id.org/fgv#domain
:domain rdf:type owl:ObjectProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain :GuidanceElement ;
        rdfs:range <http://www.w3.org/2004/02/skos/core#Concept> ;
        rdfs:comment "Field of science and technology classification (FOS) for this guidance element."@en ;
        rdfs:label "domain"@en .


###  https://w3id.org/fgv#hasFocusArea
:hasFocusArea rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :GuidanceElement ;
              rdfs:range :FocusArea ;
              rdfs:comment "Relates a guidance element to one of its focus areas (What, How, or Why)."@en ;
              rdfs:label "has focus area"@en .


###  https://w3id.org/fgv#relatesToFAIRPrinciple
:relatesToFAIRPrinciple rdf:type owl:ObjectProperty ;
                        rdfs:domain :GuidanceElement ;
                        rdfs:range <https://w3id.org/fair/principles/terms/FAIR-Principle-or-SubPrinciple> ;
                        rdfs:comment "Links a guidance element to zero or more FAIR Principles (or Sub-Principles) as defined in the FAIR Vocabulary."@en ;
                        rdfs:label "relates to FAIR Principle"@en .


###  https://w3id.org/fgv#resolvesTo
:resolvesTo rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( :Annotation
                                        :PersistentIdentifier
                                      )
                        ] ;
            rdfs:range [ rdf:type owl:Class ;
                         owl:unionOf ( :ExternalResource
                                       :ObjectOrServiceAPI
                                     )
                       ] ;
            rdfs:comment "Indicates the resource a persistent identifier or annotation resolves to (e.g., a web page, annotation, or API)."@en ;
            rdfs:label "resolves to"@en .


###  https://w3id.org/fgv#supports
:supports rdf:type owl:ObjectProperty ;
          rdfs:domain :GuidanceElement ;
          rdfs:range rdfs:Resource ;
          rdfs:comment "Relates a Guidance Element to any resource from the FAIR Testing Resource (FTR) vocabulary (e.g., Benchmark, Metric, Test, Criterion)."@en ;
          rdfs:label "supports"@en .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain :GuidanceElement ;
                                       rdfs:range xsd:string ;
                                       rdfs:comment "A textual description providing details about the guidance element."@en ;
                                       rdfs:label "description"@en .


###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain :GuidanceElement ;
                                      rdfs:range xsd:anyURI ;
                                      rdfs:comment "A globally unique IRI or other persistent identifier associated with the guidance element."@en ;
                                      rdfs:label "IRI / identifier"@en .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :GuidanceElement ;
                                 rdfs:range xsd:string ;
                                 rdfs:comment "A human-readable title of the guidance element."@en ;
                                 rdfs:label "title"@en .


###  https://schema.org/creator
<https://schema.org/creator> rdf:type owl:DatatypeProperty ;
                             rdfs:domain :GuidanceElement ;
                             rdfs:range xsd:string ;
                             rdfs:comment "A human-readable person or institution who created the guidance element."@en ;
                             rdfs:label "creator"@en .


###  https://schema.org/dateCreated
<https://schema.org/dateCreated> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain :GuidanceElement ;
                                 rdfs:range xsd:dateTime ;
                                 rdfs:comment "A date when the guidance element was created."@en ;
                                 rdfs:label "created"@en .


###  https://schema.org/dateModified
<https://schema.org/dateModified> rdf:type owl:DatatypeProperty ;
                                  rdfs:domain :GuidanceElement ;
                                  rdfs:range xsd:dateTime ;
                                  rdfs:comment "A date on which the guidance element was modified."@en ;
                                  rdfs:label "modified"@en .


###  https://schema.org/maintainer
<https://schema.org/maintainer> rdf:type owl:DatatypeProperty ;
                                rdfs:domain :GuidanceElement ;
                                rdfs:range xsd:string ;
                                rdfs:comment "A human-readable person or institution who maintains the guidance element."@en ;
                                rdfs:label "maintainer"@en .


