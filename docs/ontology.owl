    <owl:Class rdf:about="http://semanticscience.org/resource/SIO_001190"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#Resource -->


    <owl:Class rdf:about="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    


    <!-- https://schema.org/CreativeWork -->


    <owl:Class rdf:about="https://schema.org/CreativeWork"/>
    


    <!-- https://w3id.org/fair/principles/terms/FAIR-Principle-or-SubPrinciple -->


    <owl:Class rdf:about="https://w3id.org/fair/principles/terms/FAIR-Principle-or-SubPrinciple"/>
    


