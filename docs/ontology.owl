    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://example.org/fgv#describes -->


    <owl:ObjectProperty rdf:about="http://example.org/fgv#describes">
        <rdfs:domain rdf:resource="http://example.org/fgv#WebPage"/>
        <rdfs:range rdf:resource="http://example.org/fgv#ObjectOrServiceAPI"/>
        <rdfs:comment xml:lang="en">Relates a web page to the API or object it describes.</rdfs:comment>
        <rdfs:label xml:lang="en">describes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/fgv#hasFocusArea -->


    <owl:ObjectProperty rdf:about="http://example.org/fgv#hasFocusArea">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/fgv#GuidanceElement"/>
        <rdfs:range rdf:resource="http://example.org/fgv#FocusArea"/>
        <rdfs:comment xml:lang="en">Relates a guidance element to one of its focus areas (What, How, or Why).</rdfs:comment>
        <rdfs:label xml:lang="en">has focus area</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/fgv#relatesToFAIRPrinciple -->


    <owl:ObjectProperty rdf:about="http://example.org/fgv#relatesToFAIRPrinciple">
        <rdfs:domain rdf:resource="http://example.org/fgv#GuidanceElement"/>
        <rdfs:range rdf:resource="https://w3id.org/fair/principles/terms/FAIR-Principle-or-SubPrinciple"/>
        <rdfs:comment xml:lang="en">Links a guidance element to zero or more FAIR Principles (or Sub-Principles) as defined in the FAIR Vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="en">relates to FAIR Principle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/fgv#resolvesTo -->


    <owl:ObjectProperty rdf:about="http://example.org/fgv#resolvesTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/fgv#Annotation"/>
                    <rdf:Description rdf:about="http://example.org/fgv#PersistentIdentifier"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://example.org/fgv#ExternalResource"/>
                    <rdf:Description rdf:about="http://example.org/fgv#ObjectOrServiceAPI"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Indicates the resource a persistent identifier or annotation resolves to (e.g., a web page, annotation, or API).</rdfs:comment>
        <rdfs:label xml:lang="en">resolves to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/fgv#supports -->


    <owl:ObjectProperty rdf:about="http://example.org/fgv#supports">
        <rdfs:domain rdf:resource="http://example.org/fgv#GuidanceElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment xml:lang="en">Relates a Guidance Element to any resource from the FAIR Testing Resource (FTR) vocabulary (e.g., Benchmark, Metric, Test, Criterion).</rdfs:comment>
        <rdfs:label xml:lang="en">supports</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://semanticscience.org/resource/SIO_000341 -->


    <owl:ObjectProperty rdf:about="http://semanticscience.org/resource/SIO_000341">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://example.org/fgv#ExternalResource"/>
        <rdfs:range rdf:resource="http://example.org/fgv#ExternalResource"/>
        <rdfs:comment xml:lang="en">Relates an abstract reference to its single manifestation (e.g., PID, WebPage, or Annotation).</rdfs:comment>
        <rdfs:label xml:lang="en">is manifested as</rdfs:label>
    </owl:ObjectProperty>
    


