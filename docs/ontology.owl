    <!-- http://example.org/fgv# -->


    <owl:NamedIndividual rdf:about="http://example.org/fgv#">
        <terms:title xml:lang="en">FAIR Guidance Vocabulary (FGV) — Core Ontology</terms:title>
    </owl:NamedIndividual>
    


    <!-- http://example.org/fgv#HowFocus -->


    <owl:NamedIndividual rdf:about="http://example.org/fgv#HowFocus">
        <rdf:type rdf:resource="http://example.org/fgv#FocusArea"/>
        <rdfs:comment xml:lang="en">Focuses on how the guidance should be operationalized — answering &apos;How should this be done?&apos;</rdfs:comment>
        <rdfs:label xml:lang="en">Process (How)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/fgv#MoreFocus -->


    <owl:NamedIndividual rdf:about="http://example.org/fgv#MoreFocus">
        <rdf:type rdf:resource="http://example.org/fgv#FocusArea"/>
        <rdfs:comment xml:lang="en">Provides additional useful information about the topic, such as context, examples, tools, or references — answering &apos;What else is relevant or helpful to know?&apos;</rdfs:comment>
        <rdfs:label xml:lang="en">More: Additional Information</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/fgv#WhatFocus -->


    <owl:NamedIndividual rdf:about="http://example.org/fgv#WhatFocus">
        <rdf:type rdf:resource="http://example.org/fgv#FocusArea"/>
        <rdfs:comment xml:lang="en">Focuses on what the guidance means and how it can be implemented — answering &apos;What does this mean?&apos;</rdfs:comment>
        <rdfs:label xml:lang="en">Meaning / Implementation (What)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://example.org/fgv#WhyFocus -->


    <owl:NamedIndividual rdf:about="http://example.org/fgv#WhyFocus">
        <rdf:type rdf:resource="http://example.org/fgv#FocusArea"/>
        <rdfs:comment xml:lang="en">Focuses on why the guidance is important and its underlying motivation — answering &apos;Why follow this guideline?&apos;</rdfs:comment>
        <rdfs:label xml:lang="en">Motivation (Why)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://creativecommons.org/licenses/by/4.0/ -->


    <owl:NamedIndividual rdf:about="https://creativecommons.org/licenses/by/4.0/">
        <rdf:type rdf:resource="http://purl.org/dc/terms/LicenseDocument"/>
        <rdfs:comment xml:lang="en">A permissive open license allowing reuse and distribution with attribution.</rdfs:comment>
        <rdfs:label xml:lang="en">Creative Commons Attribution 4.0 International</rdfs:label>
    </owl:NamedIndividual>
