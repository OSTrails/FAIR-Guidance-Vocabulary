<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/fgv#"
     xml:base="http://example.org/fgv"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://example.org/fgv#">
        <owl:versionIRI rdf:resource="https://w3id.org/fgv/0.1.0"/>
        <terms:abstract xml:lang="en">A vocabulary to describe Guidance.</terms:abstract>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-13</terms:created>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0255-5101"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0003-1106-8441"/>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-10-13</terms:modified>
        <rdfs:comment xml:lang="en">An ontology capturing core concepts and relations from the FAIR Guidance diagram.</rdfs:comment>
        <owl:versionInfo>0.1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/abstract -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/created -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- 
