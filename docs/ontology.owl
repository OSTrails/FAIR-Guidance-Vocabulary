    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/description -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/description">
        <rdfs:domain rdf:resource="http://example.org/fgv#GuidanceElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A textual description providing details about the guidance element.</rdfs:comment>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/identifier -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/identifier">
        <rdfs:domain rdf:resource="http://example.org/fgv#GuidanceElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">A globally unique IRI or other persistent identifier associated with the guidance element.</rdfs:comment>
        <rdfs:label xml:lang="en">IRI / identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/title">
        <rdfs:domain rdf:resource="http://example.org/fgv#GuidanceElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A human-readable title of the guidance element.</rdfs:comment>
        <rdfs:label xml:lang="en">title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://example.org/fgv#Annotation -->


    <owl:Class rdf:about="http://example.org/fgv#Annotation">
        <rdfs:subClassOf rdf:resource="http://example.org/fgv#ExternalResource"/>
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001166"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/fgv#resolvesTo"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://example.org/fgv#WebPage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://example.org/fgv#PersistentIdentifier"/>
        <owl:disjointWith rdf:resource="http://example.org/fgv#WebPage"/>
        <rdfs:comment xml:lang="en">A structured note or comment associated with another resource.</rdfs:comment>
        <rdfs:label xml:lang="en">Annotation</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/fgv#Benchmark -->


    <owl:Class rdf:about="http://example.org/fgv#Benchmark">
        <rdfs:subClassOf rdf:resource="http://example.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">Quantifiable standards or reference points used to compare or evaluate performance, practices, or processes.</rdfs:comment>
        <rdfs:label xml:lang="en">Benchmark</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.org/DefinedTerm"/>
    </owl:Class>
    


    <!-- http://example.org/fgv#BestPractice -->


    <owl:Class rdf:about="http://example.org/fgv#BestPractice">
        <rdfs:subClassOf rdf:resource="http://example.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">Proven methods or approaches that are widely accepted as the most effective in achieving desired outcomes.</rdfs:comment>
        <rdfs:label xml:lang="en">Best Practice</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.org/BestPractice"/>
    </owl:Class>
    


    <!-- http://example.org/fgv#ExternalResource -->


    <owl:Class rdf:about="http://example.org/fgv#ExternalResource">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000614"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://semanticscience.org/resource/SIO_000341"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://example.org/fgv#Annotation"/>
                            <rdf:Description rdf:about="http://example.org/fgv#PersistentIdentifier"/>
                            <rdf:Description rdf:about="http://example.org/fgv#WebPage"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A resource that represents or provides access to a piece of guidance. May be a Persistent Identifier, a Web Page, or an Annotation.</rdfs:comment>
        <rdfs:label xml:lang="en">Reference / External Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/fgv#FAQ -->


    <owl:Class rdf:about="http://example.org/fgv#FAQ">
        <rdfs:subClassOf rdf:resource="http://example.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">A curated list of common queries and clear, concise answers about a product, service, policy, or process.</rdfs:comment>
        <rdfs:label xml:lang="en">Frequently Asked Questions</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.org/FAQPage"/>
    </owl:Class>
    


    <!-- http://example.org/fgv#FocusArea -->


    <owl:Class rdf:about="http://example.org/fgv#FocusArea">
        <rdfs:comment xml:lang="en">A conceptual aspect or interpretive dimension describing the emphasis of a guidance element — typically answering &apos;What?&apos;, &apos;How?&apos;, or &apos;Why?&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">Focus Area</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/fgv#Framework -->


    <owl:Class rdf:about="http://example.org/fgv#Framework">
        <rdfs:subClassOf rdf:resource="http://example.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">A conceptual or structural foundation that organizes, aligns, and relates key components (such as goals, principles, processes, roles, and tools) within a particular domain or system of practice.</rdfs:comment>
        <rdfs:label xml:lang="en">Framework</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/Standard"/>
        <rdfs:seeAlso rdf:resource="https://schema.org/Intangible"/>
    </owl:Class>
    


    <!-- http://example.org/fgv#GuidanceElement -->


    <owl:Class rdf:about="http://example.org/fgv#GuidanceElement">
        <rdfs:subClassOf rdf:resource="https://schema.org/CreativeWork"/>
        <rdfs:comment xml:lang="en">A discrete item of guidance (standard, procedure, FAQ, etc.) that can be categorized by one or more Guidance Dimensions such as Domain, Motivation, Actor, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Guidance Element</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.org/CreativeWork"/>
    </owl:Class>
    


    <!-- http://example.org/fgv#ObjectOrServiceAPI -->


    <owl:Class rdf:about="http://example.org/fgv#ObjectOrServiceAPI">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_001190"/>
        <rdfs:comment xml:lang="en">A data service or API providing machine-actionable access to guidance or data.</rdfs:comment>
        <rdfs:label xml:lang="en">Object or Service / API</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/fgv#PersistentIdentifier -->


    <owl:Class rdf:about="http://example.org/fgv#PersistentIdentifier">
        <rdfs:subClassOf rdf:resource="http://example.org/fgv#ExternalResource"/>
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000675"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/fgv#resolvesTo"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://example.org/fgv#Annotation"/>
                            <rdf:Description rdf:about="http://example.org/fgv#ObjectOrServiceAPI"/>
                            <rdf:Description rdf:about="http://example.org/fgv#WebPage"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://example.org/fgv#WebPage"/>
        <rdfs:comment xml:lang="en">An identifier that uniquely and persistently identifies a resource.</rdfs:comment>
        <rdfs:label xml:lang="en">Persistent Identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/fgv#Procedure -->


    <owl:Class rdf:about="http://example.org/fgv#Procedure">
        <rdfs:subClassOf rdf:resource="http://example.org/fgv#GuidanceElement"/>
        <rdfs:comment xml:lang="en">A defined and ordered series of steps or tasks to be performed to achieve a specific outcome or fulfill a process.</rdfs:comment>
        <rdfs:label xml:lang="en">Procedure</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.org/HowTo"/>
    </owl:Class>
    


    <!-- http://example.org/fgv#Standard -->


    <owl:Class rdf:about="http://example.org/fgv#Standard">
        <rdfs:subClassOf rdf:resource="http://example.org/fgv#GuidanceElement"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/Standard"/>
        <rdfs:comment xml:lang="en">Documented agreements containing technical specifications or criteria to ensure consistent quality, safety, or interoperability.</rdfs:comment>
        <rdfs:label xml:lang="en">Standard</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.org/TechArticle"/>
    </owl:Class>
    


    <!-- http://example.org/fgv#WebPage -->


    <owl:Class rdf:about="http://example.org/fgv#WebPage">
        <rdfs:subClassOf rdf:resource="http://example.org/fgv#ExternalResource"/>
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/SIO_000302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/fgv#describes"/>
                <owl:allValuesFrom rdf:resource="http://example.org/fgv#ObjectOrServiceAPI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A document or page accessible on the Web.</rdfs:comment>
        <rdfs:label xml:lang="en">Web Page</rdfs:label>
    </owl:Class>
    


