    "@id" : "http://purl.org/dc/terms/Standard"
  }, {
    "@id" : "https://schema.org/Intangible"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/fgv#GuidanceElement"
  } ]
