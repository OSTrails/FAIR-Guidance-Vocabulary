  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://schema.org/CreativeWork"
  } ]
}, {
  "@id" : "https://w3id.org/fgv#HowFocus",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://w3id.org/fgv#FocusArea"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Focuses on how the guidance should be operationalized — answering 'How should this be done?'"
  } ],
